# Copy to .env and fill in. Production values live in Coolify, never in the repo.

NODE_ENV=development
PORT=3001

# Postgres. In production this is the internal Coolify URL.
DATABASE_URL=postgres://whatscord:password@localhost:5432/whatscord

# Optional. Without it the API still runs, but only as a single instance:
# socket fan-out and presence stop working across replicas.
REDIS_URL=redis://default:password@localhost:6379/0

# At least 24 characters. Rotating this signs everyone out.
JWT_SECRET=change-me-to-something-long-and-random
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_DAYS=30

# Comma-separated, or * for any. The desktop app sends no Origin, so this
# only matters when the UI runs in a browser.
CORS_ORIGINS=*

# Attachments (MinIO speaks S3). Downloads are proxied through the API, so
# the bucket never has to be reachable from the internet.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=whatscord
S3_ACCESS_KEY=
S3_SECRET_KEY=
MAX_UPLOAD_MB=100

# Calls and screen sharing. Without these the call buttons return 503.
LIVEKIT_URL=wss://livekit.example.com
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
