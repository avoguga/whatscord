// WhatsCord data model.
//
// One `Room` table backs every conversation surface: a direct message, a group,
// a text channel and a voice channel are all rooms. That is what lets the
// WhatsApp-style sidebar list them together without a union query.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RoomKind {
  DM
  GROUP
  TEXT
  VOICE
  // O chat de uma transmissão. É uma sala como as outras — e é justamente por
  // isso que transmitir não precisou de um sistema de mensagens novo.
  STREAM
}

/**
 * Quem pode assistir a uma transmissão.
 * `LINK` não é "sem proteção": é proteção por posse do código, o mesmo que já
 * vale para entrar num espaço. `SPACE` amarra a transmissão a um servidor e
 * herda a régua de quem já está lá dentro.
 */
enum StreamVisibility {
  PUBLIC
  SPACE
  LINK
}

enum MemberRole {
  OWNER
  ADMIN
  MEMBER
}

/**
 * De quem é um som da bandeja.
 * Duas donas possíveis e nunca as duas: o som é de uma PESSOA (vai com ela para
 * qualquer conversa) ou de um ESPAÇO (todo mundo de lá pode tocar, e some junto
 * com o espaço). Um campo só, com dono opcional em cada lado, deixaria o estado
 * "de ninguém" ser representável — e alguém acabaria criando um.
 */
enum SoundScope {
  USER
  SPACE
}

enum Presence {
  ONLINE
  IDLE
  BUSY
  OFFLINE
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  username     String   @unique
  displayName  String
  avatarUrl    String?
  bio          String?
  passwordHash String
  presence     Presence @default(OFFLINE)
  lastSeenAt   DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  refreshTokens RefreshToken[]
  spaces        SpaceMember[]
  rooms         RoomMember[]
  messages      Message[]
  reactions     Reaction[]
  ownedSpaces   Space[]        @relation("SpaceOwner")
  spaceFolders  SpaceFolder[]
  sounds        Sound[]        @relation("SoundOwner")
  soundsCreated Sound[]        @relation("SoundAuthor")
  streams       Stream[]       @relation("StreamOwner")

  @@index([username])
}

/**
 * Um som da bandeja.
 * O ÁUDIO não fica aqui: fica no mesmo armazenamento dos anexos, e `key` é o
 * ponteiro. Guardar bytes no banco faria cada listagem de bandeja arrastar
 * megabytes por uma tela que só precisa de nome e carinha.
 * `bytes` é copiado do upload de propósito, em vez de consultado no
 * armazenamento: a tela precisa somar o que cada um já gastou da cota, e ir
 * perguntar o tamanho de vinte objetos para desenhar um painel seria caro à toa.
 */
model Sound {
  id    String     @id @default(cuid())
  name  String
  emoji String
  scope SoundScope

  // Exatamente um destes dois é preenchido. A migração impõe isso por CHECK,
  // porque o Prisma não sabe expressar "um ou outro" no schema.
  userId  String?
  spaceId String?

  // Quem subiu. Separado do dono: um administrador sobe um som PARA o espaço, e
  // depois pode deixar de ser administrador sem que o som fique órfão.
  createdById String

  key       String
  mime      String
  bytes     Int
  createdAt DateTime @default(now())

  user      User?  @relation("SoundOwner", fields: [userId], references: [id], onDelete: Cascade)
  space     Space? @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  createdBy User   @relation("SoundAuthor", fields: [createdById], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([spaceId])
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  userAgent String?
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Space {
  id         String   @id @default(cuid())
  name       String
  iconUrl    String?
  ownerId    String
  inviteCode String   @unique
  createdAt  DateTime @default(now())

  owner   User          @relation("SpaceOwner", fields: [ownerId], references: [id])
  members SpaceMember[]
  rooms   Room[]
  sounds  Sound[]
  streams Stream[]
}

model SpaceMember {
  id       String     @id @default(cuid())
  spaceId  String
  userId   String
  role     MemberRole @default(MEMBER)
  // A ordem da barra lateral é de QUEM OLHA, não do espaço: se fosse do espaço,
  // arrastar um servidor para o topo reordenaria a tela de todos os outros
  // membros. Por isso mora aqui, na associação, e não em `Space`.
  position Int        @default(0)
  // Nulo = solto, fora de qualquer pasta. A pasta também é de quem olha.
  folderId String?
  joinedAt DateTime   @default(now())

  space  Space        @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  user   User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  folder SpaceFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)

  @@unique([spaceId, userId])
  @@index([userId])
  @@index([folderId])
}

/**
 * Pasta da barra lateral, privada de cada pessoa.
 * Apagar a pasta NÃO pode apagar o que estava dentro — são espaços inteiros,
 * com as conversas de todo mundo. Daí o `SetNull` na relação: os espaços
 * voltam a ficar soltos e nada se perde.
 */
model SpaceFolder {
  id        String   @id @default(cuid())
  userId    String
  name      String
  color     String?
  position  Int      @default(0)
  createdAt DateTime @default(now())

  user    User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  members SpaceMember[]

  @@index([userId])
}

model Room {
  id        String   @id @default(cuid())
  spaceId   String?
  kind      RoomKind
  name      String?
  topic     String?
  iconUrl   String?
  position  Int      @default(0)
  // For DMs: sorted "userA:userB" so the pair can never get two rooms.
  dmKey     String?  @unique
  createdAt DateTime @default(now())

  space    Space?       @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  members  RoomMember[]
  messages Message[]
  stream   Stream?

  @@index([spaceId])
}

/**
 * Uma transmissão: uma pessoa apresenta, muitas assistem sem publicar nada.
 * A MÍDIA não está aqui e nem no banco — ela passa direto pelo LiveKit, na sala
 * `stream_<id>`. O que esta tabela guarda é quem é dono, quem pode assistir, e
 * se está no ar. Isso é de propósito: trocar a forma de entregar o vídeo (hoje
 * WebRTC para todos, amanhã HLS atrás de uma CDN) não deve mexer em uma linha
 * deste modelo.
 * `roomId` aponta para a sala do CHAT, e a relação é obrigatória e única: toda
 * transmissão nasce com a sala dela. É o que fez o bate-papo, os anexos, as
 * respostas e as não lidas virem prontos, sem uma linha nova.
 */
model Stream {
  id         String           @id @default(cuid())
  title      String
  ownerId    String
  // Só faz sentido — e só é permitido — quando `visibility` é SPACE. O CHECK
  // da migração impede a combinação sem sentido de existir.
  spaceId    String?
  visibility StreamVisibility
  /**
   * Existe SEMPRE, mesmo numa transmissão pública: é o endereço que se manda
   * para alguém. O que muda com a visibilidade é o que o código abre sozinho.
   */
  inviteCode String           @unique
  roomId     String           @unique
  /**
   * `startedAt` e `endedAt` contam a história; quem está no ar AGORA é a
   * presença no Redis, com vencimento por conexão. Um app que morre sem avisar
   * não pode deixar uma transmissão "ao vivo" para sempre na tela de todo mundo.
   */
  startedAt  DateTime?
  endedAt    DateTime?
  createdAt  DateTime         @default(now())

  owner User   @relation("StreamOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  space Space? @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  // Apagar a sala apaga a transmissão. É o caminho de apagar: some a sala, some
  // o chat por cascata, some a transmissão — uma operação só, sem sobra.
  room  Room   @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@index([ownerId])
  @@index([spaceId])
}

model RoomMember {
  id                String     @id @default(cuid())
  roomId            String
  userId            String
  role              MemberRole @default(MEMBER)
  lastReadMessageId String?
  lastReadAt        DateTime?
  muted             Boolean    @default(false)
  joinedAt          DateTime   @default(now())

  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([roomId, userId])
  @@index([userId])
}

model Message {
  id          String    @id @default(cuid())
  roomId      String
  authorId    String
  content     String    @db.Text
  // Minted by the client before sending. It is what makes a retry idempotent
  // and what lets the client tell its own optimistic bubble apart from the
  // copy that comes back over the socket — without it, one send shows twice.
  //
  // Scoped to the author, never global: a global unique would let anyone look
  // up someone else's message by guessing the id, and would make two people
  // colliding on an id silently swallow one of the sends.
  clientMsgId String?
  replyToId   String?
  createdAt   DateTime  @default(now())
  editedAt    DateTime?
  deletedAt   DateTime?

  room        Room         @relation(fields: [roomId], references: [id], onDelete: Cascade)
  author      User         @relation(fields: [authorId], references: [id], onDelete: Cascade)
  replyTo     Message?     @relation("MessageReply", fields: [replyToId], references: [id], onDelete: SetNull)
  replies     Message[]    @relation("MessageReply")
  attachments Attachment[]
  reactions   Reaction[]

  @@unique([authorId, clientMsgId])
  // Tie-break for pagination: createdAt alone is millisecond precision, and
  // messages sharing a millisecond come back in non-deterministic order —
  // which makes a cursor skip some of them permanently.
  @@index([roomId, createdAt, id])
}

model Attachment {
  id         String   @id @default(cuid())
  messageId  String
  url        String
  name       String
  mime       String
  size       Int
  width      Int?
  height     Int?
  durationMs Int?
  createdAt  DateTime @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
}

model Reaction {
  id        String   @id @default(cuid())
  messageId String
  userId    String
  emoji     String
  createdAt DateTime @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId, emoji])
  @@index([messageId])
}
